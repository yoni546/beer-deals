    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
