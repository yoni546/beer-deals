# ---------------------------------------------------------------------------
# Beer Deals — environment. Copy to `.env.local` and fill in.
# `.env.local` is git-ignored; never commit real values.
#
# NEXT_PUBLIC_* is inlined into the browser bundle. Only put things there that
# are safe in public: the project URL is not a secret, and the anon key carries
# no privileges of its own — Row Level Security decides every row it can read.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase -> Project Settings -> API Keys -> anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Deployed origin, no trailing slash. Used for auth redirects + push links.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# Which environment this is: production | staging | development. A production
# server refuses to show sample deals. Anything else shows a badge (and a red
# warning if it is connected to the production database). On Vercel, production
# deployments are recognised automatically; set this to "staging" on the
# staging / Preview environment.
APP_ENV="development"

# Web Push public key. Generate both halves with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_, never import from a Client
# Component. src/lib/env.ts refuses to read these outside the server.
# ---------------------------------------------------------------------------

# Bypasses Row Level Security entirely. Needed only to send push notifications
# (reading other users' subscriptions) and by the seed script.
SUPABASE_SERVICE_ROLE_KEY=""

VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Rings the notification worker (POST /api/notifications/run, Authorization: Bearer <this>).
# 16+ random characters, one per environment. Without it the endpoint stays closed (503).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Geocoding (docs/GEOCODING.md). These belong in the INGEST TARGET'S file
# (.env.staging.local / .env.production.local), not here and not in the shell —
# scripts/ingest/geocode.mjs reads its configuration only from there.
#
# Unset, the geocoder REFUSES every address and writes nothing, which is the
# correct behaviour for an unconfigured deployment: a missing branch position is
# visible everywhere, a wrong one is visible nowhere.
# ---------------------------------------------------------------------------

# null (the default, refuses) | nominatim
GEOCODER=""

# Required by nominatim: an email address identifying this client, per its usage
# policy. The run refuses without it.
GEOCODER_CONTACT=""
