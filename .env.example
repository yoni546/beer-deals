# ---------------------------------------------------------------------------
# Beer Deals — environment. Copy to `.env.local` and fill in.
# `.env.local` is git-ignored; never commit real values.
#
# NEXT_PUBLIC_* is inlined into the browser bundle. Only put things there that
# are safe in public: the project URL is not a secret, and the anon key carries
# no privileges of its own — Row Level Security decides every row it can read.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase -> Project Settings -> API Keys -> anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Deployed origin, no trailing slash. Used for auth redirects + push links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Web Push public key. Generate both halves with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_, never import from a Client
# Component. src/lib/env.ts refuses to read these outside the server.
# ---------------------------------------------------------------------------

# Bypasses Row Level Security entirely. Needed only to send push notifications
# (reading other users' subscriptions) and by the seed script.
SUPABASE_SERVICE_ROLE_KEY=""

VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
